# ============================================================
# LINE Chatbot - HR Assistant (SPBT)
# Environment Configuration
# ============================================================

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Database ---
# SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot.db

# PostgreSQL (production recommended)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hr_chatbot

# --- Vector Database (ChromaDB) ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Application Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Bot Persona ---
BOT_NAME=น้องแอร์
BOT_PERSONA=ผู้ช่วย HR ที่ตอบคำถามด้วยความสุภาพและชัดเจน

# --- RAG Settings ---
# Number of relevant documents to retrieve
RAG_TOP_K=5
# Minimum similarity score threshold
RAG_SCORE_THRESHOLD=0.3
# Max tokens per chunk when splitting documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
